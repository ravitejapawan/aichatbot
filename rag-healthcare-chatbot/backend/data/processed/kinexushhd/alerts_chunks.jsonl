{"chunk_id":"kinexushhd_alerts_001","app":"KINEXUSHHD","domain":"alerts","type":"text","text":"The system is not a medical device and does not control NxStage cyclers.","image_path":null,"section":"Indications for Use","page":6,"keywords":["medical device","not control","NxStage","cycler","system limitation","safety","restriction","device control"]}
